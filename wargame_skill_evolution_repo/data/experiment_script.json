{
  "description": "兵棋推演实验脚本：80题，nudge_interval=10，每块10题同/相关类别，每次Nudge有清晰失败信号",
  "nudge_interval": 10,
  "probe_question_ids": [1, 3, 5, 9, 15, 19, 25, 29, 35, 41, 45, 49, 52, 56, 60, 64, 68, 72, 76, 80],
  "expected_evolutions": [
    {
      "after_seq": 10, "block": "mobility_vehicle",
      "trigger_reason": "机动与车辆速度问题大多答对，Reviewer预期无需修改",
      "expected_action": "none_or_minor_patch", "expected_skill": "mobility"
    },
    {
      "after_seq": 20, "block": "personnel_mobility",
      "trigger_reason": "人员机动/冲锋/疲劳问题答对，Reviewer预期无需修改",
      "expected_action": "none_or_minor_patch", "expected_skill": "mobility"
    },
    {
      "after_seq": 30, "block": "direct_fire_basic",
      "trigger_reason": "直瞄射击基础问题答对，Reviewer预期无需修改",
      "expected_action": "none_or_minor_patch", "expected_skill": "direct_fire"
    },
    {
      "after_seq": 40, "block": "suppression_observation",
      "trigger_reason": "压制/掩蔽和观察问题大部分答对，可能需要微调掩蔽+射击交叉规则",
      "expected_action": "patch", "expected_skill": "direct_fire"
    },
    {
      "after_seq": 50, "block": "observation_advanced",
      "trigger_reason": "观察通视问题答对，但压制+掩蔽交叉题可能失败",
      "expected_action": "patch", "expected_skill": "direct_fire"
    },
    {
      "after_seq": 60, "block": "indirect_fire_special",
      "trigger_reason": "间瞄射击和特殊单位（巡飞弹/无人机）连续10题全部失败，完全缺失",
      "expected_action": "create", "expected_skill": "indirect_fire（新建）"
    },
    {
      "after_seq": 70, "block": "special_units_hex_combat",
      "trigger_reason": "特殊单位（直升机）和同格交战全部失败，完全缺失",
      "expected_action": "create", "expected_skill": "special_units（新建）和 same_hex_combat（新建）"
    },
    {
      "after_seq": 80, "block": "complex_rules",
      "trigger_reason": "聚合解聚、工事、雷场、防空、引导射击等复杂规则全部失败",
      "expected_action": "create", "expected_skill": "complex_rules（新建）"
    }
